<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.docsys.agent.learning.repository.UserBehaviorTagRepository">

    <resultMap id="UserBehaviorTagResultMap" type="com.docsys.agent.learning.entity.UserBehaviorTag">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="tag" column="tag"/>
        <result property="weight" column="weight"/>
        <result property="actionCount" column="action_count"/>
        <result property="lastActionAt" column="last_action_at"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="findByUserId" resultMap="UserBehaviorTagResultMap">
        SELECT * FROM user_behavior_tags WHERE user_id = #{userId}
    </select>

    <select id="findByUserIdAndTenantId" resultMap="UserBehaviorTagResultMap">
        SELECT * FROM user_behavior_tags WHERE user_id = #{userId} AND tenant_id = #{tenantId}
    </select>

    <select id="findByUserIdAndTag" resultMap="UserBehaviorTagResultMap">
        SELECT * FROM user_behavior_tags WHERE user_id = #{userId} AND tag = #{tag}
    </select>

    <select id="findAllUserIds" resultType="string">
        SELECT DISTINCT user_id FROM user_behavior_tags
    </select>

    <select id="findTagsByUserId" resultType="string">
        SELECT tag FROM user_behavior_tags WHERE user_id = #{userId}
    </select>

    <delete id="deleteByUserId">
        DELETE FROM user_behavior_tags WHERE user_id = #{userId}
    </delete>

    <insert id="insert" parameterType="com.docsys.agent.learning.entity.UserBehaviorTag" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user_behavior_tags (user_id, tenant_id, tag, weight, action_count, last_action_at, created_at)
        VALUES (#{userId}, #{tenantId}, #{tag}, #{weight}, #{actionCount}, #{lastActionAt}, #{createdAt})
    </insert>

    <update id="updateById" parameterType="com.docsys.agent.learning.entity.UserBehaviorTag">
        UPDATE user_behavior_tags SET
            user_id = #{userId},
            tenant_id = #{tenantId},
            tag = #{tag},
            weight = #{weight},
            action_count = #{actionCount},
            last_action_at = #{lastActionAt}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM user_behavior_tags WHERE id = #{id}
    </delete>

</mapper>
